    "onedrive": false,
    "hyperV": true,
    "wsl2": true,
    "windowsSandbox": false,
    "virtualization": false,
    "docker": false,
    "remoteDesktop": false,
    "windowsHello": true,
    "bitLocker": true,
    "touch": false,
    "pen": false,
    "windowsSearch": true,
    "phoneLink": false,
    "widgets": false,
    "teams": false,
    "copilot": false,
    "locationServices": false,
    "telemetryDiagnostics": false,
    "visualStudio": true,
    "sqlServer": false,
    "gpuVendorUtilities": true,
    "rgbSoftware": false,
    "motherboardUtilities": false,
    "fileSharing": false,
    "smb": false,
    "developerMachine": true,
    "gamingMachine": true
  }
